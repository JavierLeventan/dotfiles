" Plugin management with vim-plug (example)
call plug#begin()
Plug 'junegunn/vim-easy-align'
call plug#end()

" Disable vi compatibility
set nocompatible

" Enable syntax highlighting
syntax on

" Display line numbers
"set nu

" Use spaces instead of tabs, 4 spaces per tab
set expandtab
set shiftwidth=4
set softtabstop=4

" Enable smart indentation
set autoindent
set smartindent

" Set color scheme (example)
"colorscheme gruvbox

" Start interactive EasyAlign in visual mode (e.g. vipga)
xmap ga <Plug>(EasyAlign)

" Start interactive EasyAlign for a motion/text object (e.g. gaip)
nmap ga <Plug>(EasyAlign)

"### Maps ####
" Remap space bar
map <space> <leader>

nmap <space>q :q<enter>

" Windows
nmap <leader>ws :split<enter>
nmap <leader>wv :vsplit<enter>
nmap <leader>wn <c-w>W
nmap <leader>wp <c-w>w
" Tabs
nmap <leader>te :tabedit<Space>
nmap <leader>tn :tabnext<enter>
nmap <leader>tp :tabprevious<enter>
