window-rule {
    geometry-corner-radius 1
    clip-to-geometry true    // Clips window contents to the rounded corner boundaries.
}

window-rule {
    match app-id=r#"^com.stremio.stremio$"# title="^Stremio"

    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id=r#"^zen$"# title="^Zen Browser$"

    default-column-width { proportion 0.9; }
}

window-rule {
    match app-id=r#"^zen$"# title="^Zen Browser$"
    match app-id=r#"^steam$"# title="^Steam$"

    default-column-width { proportion 0.7; }
}

// block out two password managers from screen capture.
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"
}


// Floating Windows
window-rule {
    match app-id=r#"^org\.kde\.kalk$"# title="^Kalk"
    match title="^Unlock Database - KeePassXC$"

    open-floating true
}

// pavucontrol window
window-rule {
    match app-id="org.pulseaudio.pavucontrol" title=r#"^Volume Control$"#

    default-column-width { fixed 500; }
    default-window-height { fixed 500; }
    focus-ring { width 1; }
    open-floating true
    default-floating-position x=5 y=5 relative-to="top-right"
}

// Steam notification popup
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#

    open-focused false
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia.Settings"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}
